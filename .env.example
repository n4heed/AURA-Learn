# Secret used to sign the demo session cookie. Change for any shared deployment.
AUTH_SECRET=change-me-to-a-long-random-string

# Optional: where the file-backed demo database lives (defaults to ./data/store.json)
# AURA_DB_PATH=./data/store.json

# ---- Supabase Auth (required for real email/password accounts) ----
# The URL and publishable key are safe to expose to the browser. Keep service-role keys out of this project.
NEXT_PUBLIC_SUPABASE_URL=https://wipkaskntseobnzpecdh.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_RkLnMEPrji6BhI8AsjaX7w_B5cWnD_B
# Optional: when set, only someone with this code can register as a facilitator.
# FACILITATOR_INVITE_CODE=

# ---- AI contextual re-theming (all optional: without ANY key the app uses built-in themes) ----
# Server-side only. Never prefix any of these with NEXT_PUBLIC_ and never commit real keys.
#
# Which provider to use. You do not need to set every provider below — only the one(s) you configure
# a key for. A missing key simply makes that provider unavailable (falls back to built-in themes),
# it never crashes the app.
#   openrouter | groq | gemini | nvidia   use exactly that provider (no fallback to a different one)
#   auto (default)                        use the first configured provider, in this priority order:
#                                          openrouter, then groq, then gemini, then nvidia
#   template                              built-in themes only, no live model is ever called
#   off                                   always show the original, un-themed question
# AI_PROVIDER=auto
# Shared default model, used only when a provider-specific *_MODEL below isn't set.
# AI_MODEL=

# OpenRouter (https://openrouter.ai) — aggregates many models behind one OpenAI-compatible API.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Groq (https://console.groq.com) — OpenAI-compatible, very fast inference.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (https://ai.google.dev) — native REST API, not OpenAI-compatible.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# NVIDIA NIM (https://build.nvidia.com) — OpenAI-compatible.
# NVIDIA_API_KEY=
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# AI_TIMEOUT_MS=7000
# AI_MAX_CALLS_PER_MINUTE=30
# Deprecated alias, kept for compatibility: template/off (use AI_PROVIDER instead).
# AI_RETHEME_MODE=auto
# The AI studio can reveal answer keys to demonstrate they never change. Set to false outside demos.
# AURA_ALLOW_ANSWER_REVEAL=true
